{
  // MuWeb's Spanish layout of the Discord server, in place of OpenMU's English one
  // (repos/OpenMU-master/src/Discord/Provisioning/DefaultLayout.json, same keys). The bot is Aurora,
  // Mu Cow's messenger: the topics speak in her voice, between « ».
  // Existing roles, categories and channels are adopted by their name; the missing ones are created.
  "roles": [
    { "key": "gm", "name": "GM", "color": "#E67E22", "isHoisted": true },
    { "key": "linked", "name": "Jugador vinculado", "color": "#2ECC71" }
  ],
  "categories": [
    {
      "key": "info",
      "name": "Información",
      "channels": [
        { "key": "announcements", "name": "anuncios", "topic": "«Lo que tienes que saber, te lo digo aquí primero.» Novedades oficiales de Mu Cow.", "isAnnouncement": true, "isReadOnly": true, "notifications": [ "Notices" ] },
        { "key": "events", "name": "eventos", "topic": "«Cuando se abre una puerta, te aviso.» Blood Castle, Devil Square, Chaos Castle e invasiones.", "isReadOnly": true, "notifications": [ "Events", "CastleSiege" ] },
        { "key": "server-status", "name": "estado-del-servidor", "topic": "«Desde aquí veo si el continente está despierto.» El estado de los servidores, al día.", "isReadOnly": true, "showsStatus": true }
      ]
    },
    {
      "key": "community",
      "name": "Comunidad",
      "channels": [
        { "key": "general", "name": "general", "topic": "«Siéntate junto a la fuente, viajero.» Conversa de lo que quieras." },
        { "key": "world-news", "name": "noticias-del-mundo", "topic": "«Lo que veo desde arriba: jefes caídos, tesoros encontrados, héroes que crecen.»", "isReadOnly": true, "notifications": [ "WorldNews" ] },
        { "key": "world-chat", "name": "chat-mundial", "topic": "«Lo que se dice aquí, se oye en todo el continente.» Conectado al chat mundial del juego (/world).", "isWorldChat": true }
      ]
    },
    {
      "key": "players",
      "name": "Jugadores",
      "channels": [
        { "key": "commands", "name": "comandos", "topic": "«Pregúntame lo que quieras.» /online, /who, /guild, /rank y /events." },
        { "key": "trade", "name": "comercio", "topic": "«Todo tiene su precio.» Compra, vende e intercambia. Los tratos se cierran en el juego; Mu Cow no responde por acuerdos entre jugadores." },
        { "key": "party", "name": "busco-party", "topic": "«Nadie llega lejos solo.» Busca party, guild o compañeros para los eventos." },
        { "key": "bugs", "name": "bugs", "topic": "«Si algo en el mundo se rompe, cuéntamelo.» Qué pasó, dónde y cómo repetirlo; una captura ayuda mucho." },
        { "key": "suggestions", "name": "sugerencias", "topic": "«Tus ideas también dan forma a Mu Cow.» Propón cambios y vota con reacciones." }
      ]
    },
    {
      // The channels for the chats of guilds are created here with /guildchat create.
      "key": "guilds",
      "name": "Guilds",
      "channels": []
    },
    {
      "key": "staff",
      "name": "Staff",
      "visibleTo": [ "gm" ],
      "channels": [
        { "key": "staff-alerts", "name": "alertas-staff", "topic": "Registro de los comandos de GM usados desde Discord.", "isReadOnly": true, "notifications": [ "StaffAlerts" ] },
        { "key": "gm-commands", "name": "comandos-gm", "topic": "/announce, /kick y /ban. Cada uso queda en #alertas-staff." }
      ]
    }
  ]
}
